{
  "name": "tmax",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Use tmax-managed model access inside DeepSeek Harness.",
  "exports": {
    ".": "./dsh-plugin/index.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./dsh-plugin/icon.svg",
    "./client": "./dsh-plugin/client.js"
  },
  "files": [
    "dsh-plugin/index.js",
    "dsh-plugin/client.js",
    "dsh-plugin/quota.js",
    "dsh-plugin/host/",
    "dsh-plugin/cordis.patch.yml",
    "dsh-plugin/icon.svg",
    "dsh-plugin/README.md",
    "locale/*.json",
    "LICENSE"
  ],
  "engines": {
    "dsh": ">=0.2.3-alpha.2 <0.3.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./dsh-plugin/cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-settings-models",
        "@deepseek-ai/dsh-client-ui-tool"
      ]
    }
  },
  "scripts": {
    "test": "node --test dsh-plugin/test/*.test.mjs"
  },
  "license": "GPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "https://github.com/suraciii/tmax.git"
  }
}
